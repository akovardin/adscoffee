{
  "title": "Caffeine Analytics",
  "uid": "caffeine-analytics",
  "version": 2,
  "schemaVersion": 39,
  "timezone": "Europe/Moscow",
  "editable": true,
  "tags": [
    "caffeine",
    "ads"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "panels": [
    {
      "title": "Last 7 days: requests / responses / impressions / clicks / money",
      "type": "table",
      "id": 100,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Money"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyRUB"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  toDate(timestamp, 'Europe/Moscow') AS Day,\n  sum(requests)    AS Requests,\n  sum(responses)   AS Responses,\n  sum(impressions) AS Impressions,\n  sum(clicks)      AS Clicks,\n  sum(money)       AS Money\nFROM\n(\n  SELECT timestamp, count AS requests, 0 AS responses, 0 AS impressions, 0 AS clicks, toDecimal64(0, 3) AS money\n  FROM analytics.requests_hour WHERE timestamp >= now() - INTERVAL 7 DAY\n\n  UNION ALL\n\n  SELECT timestamp, 0, count, 0, 0, toDecimal64(0, 3)\n  FROM analytics.responses_hour WHERE timestamp >= now() - INTERVAL 7 DAY\n\n  UNION ALL\n\n  SELECT timestamp, 0, 0, count, 0, toDecimal64(0, 3)\n  FROM analytics.impressions_hour WHERE timestamp >= now() - INTERVAL 7 DAY\n\n  UNION ALL\n\n  SELECT timestamp, 0, 0, 0, count, toDecimal64(0, 3)\n  FROM analytics.clicks_hour WHERE timestamp >= now() - INTERVAL 7 DAY\n\n  UNION ALL\n\n  SELECT timestamp, 0, 0, 0, 0, revenue\n  FROM analytics.impressions_hour WHERE timestamp >= now() - INTERVAL 7 DAY\n)\nGROUP BY Day\nORDER BY Day DESC",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Revenue change (last 7 days)",
      "type": "timeseries",
      "id": 101,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "timeFrom": "now-7d",
      "timeTo": "now",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyRUB",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true,
            "fillOpacity": 20,
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "queryType": "sql",
          "format": 0,
          "rawSql": "SELECT\n  toStartOfDay(timestamp, 'Europe/Moscow') AS t,\n  sum(revenue) AS Revenue\nFROM analytics.impressions_hour\nWHERE timestamp >= now() - INTERVAL 7 DAY\nGROUP BY t\nORDER BY t",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Requests",
      "type": "timeseries",
