# Caffeine platform — production environment.
# Copy to .env and set real values: cp .env.example .env
#
# For running binaries on the host against `docker compose` infra, create
# .env.dev with localhost hosts (see "Service hosts" below) and point VS Code
# launch configs at it.

# --- Service hosts (docker compose network) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_ADDRS=["redis:7001"]
KAFKA_SEEDS=["kafka1:9092","kafka2:9092","kafka3:9092"]
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
# For .env.dev use published ports instead:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=6432
# REDIS_ADDRS=["127.0.0.1:7001"]
# KAFKA_SEEDS=["localhost:19092","localhost:29092","localhost:39092"]
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=9000

# --- PostgreSQL (admin + server) ---
POSTGRES_USER=adscoffee
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=adscoffee

# --- ClickHouse (analytics) ---
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE
CLICKHOUSE_DB=analytics

# --- Kafka UI ---
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=CHANGE_ME_KAFKA_UI

# --- Dagu (analytics scheduler) ---
DAGU_AUTH_BASIC_USERNAME=admin
DAGU_AUTH_BASIC_PASSWORD=CHANGE_ME_DAGU

# --- S3 object storage (Yandex Object Storage, MinIO, ...) ---
S3_BUCKET=adscoffee
S3_ENDPOINT=https://storage.yandexcloud.net/
S3_ACCESS_ID=CHANGE_ME_S3_ACCESS_ID
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_REGION=RU
# true for MinIO and other path-style endpoints, false for Yandex/VirtualHosted
S3_FORCE_PATH_STYLE=false

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
# Внешний адрес Grafana для iframe в админке (должен открываться из браузера).
GRAFANA_URL=https://grafana.ads.coffee
# Корневой URL Grafana (для корректных редиректов за reverse-proxy).
GRAFANA_ROOT_URL=https://grafana.ads.coffee/
# false — Grafana требует авторизацию; true — анонимный доступ (Viewer).
GRAFANA_ANONYMOUS_ENABLED=false

# --- Admin (qor5 login) ---
# false — если админка открыта по plain HTTP (http://IP:8072);
# true  — если за HTTPS (nginx/letsencrypt), иначе браузер не сохранит cookie.
CookieSecure=false

# --- Image tags (registry.gitflic.ru/project/kovardin/adscoffee) ---
SERVER_IMAGE_TAG=latest
ADMIN_IMAGE_TAG=latest
ANALYTICS_IMAGE_TAG=latest
