          "queryType": "sql",
          "rawSql": "SELECT $__timeInterval(timestamp) AS t, sum(count) AS \"Responses\" FROM analytics.responses_hour WHERE $__timeFilter(timestamp) GROUP BY t ORDER BY t",
          "format": 0,
          "refId": "A"
        }
      ]
    },
